// The site on Cloudflare: one Worker that serves out/ as static assets and
// hands the legacy Rails app's paths to the origin behind the uberblick.ai DNS
// record (worker/index.js). Deployed by .github/workflows/deploy.yml; put in
// front of the domain by the routes in uberblick-infra.
{
  "name": "uberblick-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    // out/<path>/index.html is served at /<path>; /<path>/ redirects there.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Every request reaches worker/index.js first, so the legacy paths never
    // fall through to a 404 page and other hosts redirect before any asset is served.
    "run_worker_first": true
  },
  // The routes uberblick.ai/* and www.uberblick.ai/* are Terraform's, in
  // uberblick-infra (cloudflare/website.tf), so the cut-over and the rollback
  // are an apply there. A deploy here only updates the script.
  "routes": []
}
